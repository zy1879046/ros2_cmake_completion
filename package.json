{
  "name": "ros2-cmake-completion",
  "displayName": "ROS 2 CMake Completion",
  "publisher": "zhangyu",
  "description": "Context-aware ROS 2 CMake completion for package and target commands",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ROS 2",
    "ROS2",
    "CMake",
    "ament_cmake",
    "pluginlib",
    "rclcpp_components"
  ],
  "activationEvents": [
    "onLanguage:cmake",
    "workspaceContains:**/CMakeLists.txt",
    "workspaceContains:**/*.cmake"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "npm run package && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "2.26.1"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12",
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
